{
  "name": "paged-one-based",
  "integration": "elastic-defend",
  "description": "A 1-based walk, which is what the published OpenAPI describes (page minimum 1, default 1) even though shipped Kibana is 0-based. Because the first request omits page and later requests trust the page number the server itself reported, a deployment that really did number from 1 is walked correctly: the second request asks for page=2, and page=1 is never requested at all.",
  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-api-key",
    "page_size": "2"
  },
  "routes": [
    {
      "name": "page-two",
      "match": {"method": "GET", "path": "/api/endpoint/metadata", "query_contains": "page=2"},
      "responses": [
        {
          "status": 200,
          "json": {
            "data": [
              {
                "host_status": "healthy",
                "last_checkin": "2026-08-30T10:02:00.000Z",
                "metadata": {
                  "agent": {"id": "cccccccc-1111-4000-8000-000000000003", "version": "8.15.2"},
                  "host": {"hostname": "fixture-13", "ip": ["10.30.0.3"], "mac": ["00:16:3e:11:00:03"], "os": {"name": "Windows", "version": "23H2"}}
                }
              }
            ],
            "page": 2,
            "pageSize": 2,
            "total": 3
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "page-one",
      "match": {"method": "GET", "path": "/api/endpoint/metadata"},
      "responses": [
        {
          "status": 200,
          "json": {
            "data": [
              {
                "host_status": "healthy",
                "last_checkin": "2026-08-30T10:00:00.000Z",
                "metadata": {
                  "agent": {"id": "aaaaaaaa-1111-4000-8000-000000000001", "version": "8.15.2"},
                  "host": {"hostname": "fixture-11", "ip": ["10.30.0.1"], "mac": ["00:16:3e:11:00:01"], "os": {"name": "Windows", "version": "23H2"}}
                }
              },
              {
                "host_status": "offline",
                "last_checkin": "2026-08-30T10:01:00.000Z",
                "metadata": {
                  "agent": {"id": "bbbbbbbb-1111-4000-8000-000000000002", "version": "8.15.2"},
                  "host": {"hostname": "fixture-12", "ip": ["10.30.0.2"], "mac": ["00:16:3e:11:00:02"], "os": {"name": "Linux", "version": "22.04"}}
                }
              }
            ],
            "page": 1,
            "pageSize": 2,
            "total": 3
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 3,
    "request_count": 2,
    "requests_include": [
      {"query_contains": "page=2"}
    ],
    "requests_absent": [
      {"query_contains": "page=0"},
      {"query_contains": "page=1"}
    ],
    "log_contains": ["elastic-defend: reported 3 of 3 endpoints"]
  }
}
