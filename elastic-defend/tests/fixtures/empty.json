{
  "name": "empty",
  "integration": "elastic-defend",
  "description": "An estate with no endpoints. Zero assets is a legitimate result, reported plainly as a successful run -- not an error, and not silence.",
  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-api-key"
  },
  "routes": [
    {
      "match": {"method": "GET", "path": "/api/endpoint/metadata"},
      "responses": [
        {"status": 200, "json": {"data": [], "page": 0, "pageSize": 100, "total": 0}}
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 0,
    "request_count": 1,
    "log_contains": [
      "elastic-defend: reported 0 of 0 endpoints",
      "elastic-defend: no endpoints retrieved"
    ]
  }
}
