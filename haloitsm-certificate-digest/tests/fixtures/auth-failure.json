{
  "name": "auth-failure",
  "description": "Rejected Halo client credentials fail the outbound task without creating a ticket.",
  "kwargs": {
    "runzero_url": "$BASE",
    "runzero_api_token": "fixture-runzero-token",
    "organization_ids": "11111111-1111-4111-8111-111111111111",
    "scope_label": "Fixture services",
    "schedule_anchor_utc": "2000-01-03T09:00:00Z",
    "halo_api_url": "$BASE/api",
    "halo_auth_url": "$BASE/auth",
    "halo_client_id": "fixture-client",
    "halo_client_secret": "fixture-secret",
    "halo_tickettype_id": 5,
    "halo_team_id": 4
  },
  "routes": [
    {
      "match": {"method": "POST", "path": "/auth/token"},
      "responses": [{"status": 401, "json": {"error": "invalid_client"}}]
    }
  ],
  "expect": {
    "asset_count": 0,
    "request_count": 1,
    "error_contains": ["401"],
    "requests_absent": [{"path_contains": "/api/Tickets"}],
    "log_absent": ["fixture-secret"]
  }
}